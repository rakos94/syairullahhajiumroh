MONGO_USERNAME=admin
MONGO_PASSWORD=secret
MONGODB_URI=mongodb://admin:secret@localhost:27017
MONGODB_DATABASE=syairullah_hajiumroh
APP_PORT=8080
UPLOAD_DIR=./uploads

# --- Keamanan (WAJIB diganti sebelum online, lihat README "Keamanan") ---
# Buat dengan: openssl rand -hex 32   (aplikasi menolak jalan di production dengan nilai default)
JWT_SECRET=change-me-in-production
# Hanya dipakai saat super admin PERTAMA KALI dibuat. Setelah itu password diganti di menu Admin.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# Pemulihan akun: set true sekali untuk mereset password super admin ke ADMIN_PASSWORD,
# lalu kembalikan ke false setelah berhasil login.
ADMIN_RESET_PASSWORD=false
# Swagger (/swagger) — default nyala di development, mati di production.
# ENABLE_SWAGGER=false

# --- Docker (docker compose) ---
# Port di host untuk container aplikasi (default 8080).
APP_PUBLISH_PORT=8080
# Domain publik untuk HTTPS via Caddy (make docker-https).
DOMAIN=haji.example.com

# --- Backup (make docker-app menjalankan service backup) ---
# Jam backup harian (HH:MM, WIB) dan jumlah backup terbaru yang disimpan (yang lebih lama dihapus).
BACKUP_TIME=02:00
BACKUP_KEEP=7
# Folder backup di server (default ./backups).
# BACKUP_DIR=./backups
